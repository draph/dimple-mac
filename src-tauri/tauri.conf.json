{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dimple",
  "version": "1.0.2",
  "identifier": "com.draph.dimple",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dimple",
        "width": 480,
        "height": 560,
        "minWidth": 360,
        "minHeight": 440,
        "visible": false,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "popover"
          ],
          "state": "active",
          "radius": 12
        },
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "infoPlist": "Info.plist"
    },
    "resources": {
      "resources/en.lproj/": "en.lproj/",
      "resources/zh-Hans.lproj/": "zh-Hans.lproj/",
      "icons/Assets.car": "Assets.car",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE": "LICENSE"
    }
  }
}
